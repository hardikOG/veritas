# Copy to .env and adjust for local use. Every value here is read by core/config.py.

# --- Core infra ---
APP_NAME=veritas
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://veritas:veritas@postgres:5432/veritas
REDIS_URL=redis://redis:6379/0

# --- Embedding (Phase 1) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIM=384

# --- Hybrid retrieval (Phase 2) ---
RERANK_TOP_K=8
RRF_K=60

# --- Cite-or-refuse verifier (Phase 3) ---
VERIFIER_THRESHOLD=0.62
VERIFIER_MAX_FAILED_RATIO=0.4

# --- LLM (Phase 3) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Async ingestion (Phase 1) ---
CELERY_CONCURRENCY=2
INGEST_MAX_RETRIES=5

# --- CORS (frontend, post-Phase 6) ---
# Comma-separated allowed origins for browser calls to this API, e.g.
# https://veritas-frontend.vercel.app. Empty = no CORS middleware installed.
CORS_ALLOWED_ORIGINS=

# --- Postgres container init (used by docker-compose, not by the app directly) ---
POSTGRES_USER=veritas
POSTGRES_PASSWORD=veritas
POSTGRES_DB=veritas
