FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt requirements-embedding.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

RUN useradd --create-home --shell /usr/sbin/nologin veritas
RUN mkdir -p /home/veritas/.cache && chown -R veritas /home/veritas/.cache
USER veritas

# Pre-download the embedding model at build time (not first-task time) so the very
# first document ingested doesn't pay a multi-second/network-dependent cold-start
# cost, and so a Render deploy doesn't need outbound HF Hub access at runtime.
# Placed before the app-source COPY below (not after) so editing application code
# doesn't invalidate this layer and force a ~90MB re-download on every rebuild —
# this step only actually depends on requirements-worker.txt, already installed above.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

COPY worker ./worker
COPY core ./core
COPY db ./db
COPY models ./models
COPY embedding ./embedding
COPY ingestion ./ingestion
# eval/seed.py runs here (`python -m eval.seed`) since it needs ingestion.tasks
# (pypdf) — the api image deliberately doesn't carry pypdf. eval/runner.py (which
# imports api.ask) is never invoked from the worker, so this does not need api/.
COPY eval ./eval

# Shell form (not exec-form list) so CELERY_CONCURRENCY expands at container start;
# --concurrency here is the Celery CLI flag, kept in sync with core.config.Settings.celery_concurrency.
# --include registers ingestion.tasks on this process only — see worker/celery_app.py.
CMD celery -A worker.celery_app worker --loglevel=INFO --concurrency=${CELERY_CONCURRENCY:-2} --include=ingestion.tasks
