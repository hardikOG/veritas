FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api ./api
COPY core ./core
COPY db ./db
COPY models ./models
COPY migrations ./migrations
COPY alembic.ini .
# Only celery_app.py (broker/backend config) — needed to enqueue tasks by name via
# send_task(); ingestion/embedding and their heavy ML deps are worker-only, see
# docker/Dockerfile.worker.
COPY worker ./worker

RUN useradd --create-home --shell /usr/sbin/nologin veritas
RUN mkdir -p /data/uploads && chown -R veritas /data/uploads
USER veritas

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
