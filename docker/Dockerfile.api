FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt requirements-embedding.txt ./
RUN pip install --no-cache-dir -r requirements-embedding.txt

RUN useradd --create-home --shell /usr/sbin/nologin veritas
RUN mkdir -p /home/veritas/.cache && chown -R veritas /home/veritas/.cache
USER veritas

# Pre-download the embedding model at build time — GET /search and POST /ask both
# embed the query text synchronously, so the first real request shouldn't pay a
# network-dependent cold-start. Placed before the app-source COPY below so editing
# application code doesn't force a re-download — same reasoning as
# docker/Dockerfile.worker.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

COPY api ./api
COPY core ./core
COPY db ./db
COPY models ./models
COPY migrations ./migrations
COPY alembic.ini .
# celery_app.py (broker/backend config) — needed to enqueue ingestion tasks by name
# via send_task(); ingestion/'s own heavy deps (pypdf) stay worker-only, see
# docker/Dockerfile.worker — but embedding/ is needed here too, for query embedding.
COPY worker ./worker
COPY embedding ./embedding
COPY retrieval ./retrieval
COPY llm ./llm
COPY verifier ./verifier
# eval/seed.py (worker-only, imports ingestion.tasks -> pypdf) is not imported by
# any api code path — api only ever imports eval.runner/eval.metrics, so copying
# the whole package here does not pull pypdf into this image. See eval/seed.py's
# module docstring.
COPY eval ./eval

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
